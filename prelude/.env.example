# ── Prelude environment ────────────────────────────────────────────────────
# Every variable is optional. With none set the app runs in demo mode and the
# header says `demo`. Copy this file to .env.local and fill in what you have.

# ── Backend origin ─────────────────────────────────────────────────────────
# Where the plugin sends its writes. In dev this is empty (same-origin).
# In a packaged .ehpk it MUST be an absolute https origin, and that origin must
# also appear in app.json permissions[network].whitelist.
NEXT_PUBLIC_API_BASE=

# ── Shared secret for /api/act ─────────────────────────────────────────────
# When set, every write must carry `x-prelude-key: <value>`. Leave empty for a
# local demo; set it for anything reachable from the internet.
PRELUDE_ACT_KEY=

# ── Integrations (all optional) ────────────────────────────────────────────
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_DATABASE_ID=

SLACK_TOKEN=
SLACK_CHANNEL=

# ── Voice (optional) ───────────────────────────────────────────────────────
STT_API_KEY=

# ── LLM (optional) ─────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Defaults to TokenRouter.
# With no key the transcript classifier falls back to deterministic keyword
# rules, so the demo never depends on a model.
LLM_API_KEY=
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017-free

# Legacy alias — still read, but LLM_* takes precedence.
OPENROUTER_API_KEY=

# ── Web enrichment (optional) ──────────────────────────────────────────────
# When a meeting has no thread and no doc, Exa supplies one citable line about
# the person. With no key the brief renders exactly as before.
EXA_API_KEY=

# ── Email write target (optional) ──────────────────────────────────────────
# Makes "reply" deliverable to an external attendee. Resend honours an
# Idempotency-Key header, so a retry does not send twice.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# ── Terminal 3 (optional) ──────────────────────────────────────────────────
# Hardware-attested mandates for agentic actions. When set, every write is
# attested and the receipt carries the attestation reference.
# Get a key at https://docs.terminal3.io/developers/adk/get-started/prerequisites/request-test-tokens
T3N_API_KEY=
T3N_DID=

# ── FairScale (optional) ───────────────────────────────────────────────────
# Agent/LLM routing. Get a key at https://swagger.api.fairscale.xyz/
FAIRSCALE_API_KEY=

# ── Database (optional) ────────────────────────────────────────────────────
# With DATABASE_URL set, the action store is Postgres and history survives a
# restart. Without it, the store is in-memory and cleared on restart.
# Neon's pooled connection string works as-is.
DATABASE_URL=
